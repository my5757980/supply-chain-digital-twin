# apps/api environment (see specs/001-supply-chain-digital-twin/quickstart.md)
PORT=4000
# Comma-separated origins allowed to call this API with session cookies.
# Must list the frontend explicitly — a wildcard is rejected by browsers
# for credentialed requests.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://app_runtime:app_runtime_local_dev@localhost:5433/scdt
MIGRATE_DATABASE_URL=postgresql://scdt:scdt_local_dev@localhost:5433/scdt
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-strong-random-secret
AI_SERVICE_URL=http://localhost:4100
AI_SERVICE_TOKEN=replace-with-a-shared-service-token
