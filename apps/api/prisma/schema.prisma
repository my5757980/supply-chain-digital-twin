// Prisma schema for the Supply Chain Digital Twin platform service.
// Entities per specs/001-supply-chain-digital-twin/data-model.md.
// Tenant-scoped tables are additionally protected by PostgreSQL Row-Level
// Security policies applied via a raw-SQL migration (see T009) — RLS is not
// expressible in the Prisma schema DSL itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries (PrismaClient) connect as the least-privilege
  // `app_runtime` role so PostgreSQL Row-Level Security actually applies —
  // see the RLS section of the init_foundational migration for why this
  // must NOT be the superuser used for migrations.
  url       = env("DATABASE_URL")
  // Migrations (`prisma migrate ...`) connect as the superuser so they can
  // create roles/tables/policies.
  directUrl = env("MIGRATE_DATABASE_URL")
}

// --- Foundational (T008) -----------------------------------------------

enum OnboardingStatus {
  pending
  data_connected
  active
}

model Tenant {
  id                    String           @id @default(uuid())
  businessName          String           @map("business_name")
  sector                String
  country                String          @default("AE")
  onboardingStatus      OnboardingStatus @default(pending) @map("onboarding_status")
  /// Constitution Principle V: gates activation until the SME has explicitly
  /// consented to their supply-chain signals being sent to the Claude API.
  aiProcessingConsentAt DateTime?        @map("ai_processing_consent_at")
  createdAt             DateTime         @default(now()) @map("created_at")

  users                  User[]
  dataSources            DataSource[]
  suppliers              Supplier[]
  inventoryItems         InventoryItem[]
  orders                 Order[]
  disruptionPredictions  DisruptionPrediction[]
  alerts                 Alert[]
  autoTriggerRules       AutoTriggerRule[]

  @@map("tenants")
}

enum UserRole {
  owner
  staff
  platform_admin
}

model User {
  id             String   @id @default(uuid())
  /// Nullable only for platform_admin (cross-tenant support role).
  tenantId       String?  @map("tenant_id")
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  emailOrPhone   String   @map("email_or_phone")
  role           UserRole
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  recommendationDecisions Recommendation[]
  autoTriggerRules        AutoTriggerRule[]

  @@unique([tenantId, emailOrPhone])
  @@map("users")
}

enum DataSourceType {
  manual
  csv_upload
  pos_integration
  erp_integration
}

enum DataSourceStatus {
  active
  stale
  disconnected
}

model DataSource {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  type         DataSourceType
  status       DataSourceStatus  @default(active)
  lastSyncedAt DateTime?         @map("last_synced_at")

  inventoryItems InventoryItem[]

  @@map("data_sources")
}

// --- User Story 1 (T024-T027) -------------------------------------------

enum SupplierKind {
  primary
  backup
}

enum SupplierStatus {
  active
  delayed
  at_risk
}

model Supplier {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  name                String
  kind                SupplierKind
  status              SupplierStatus @default(active)
  typicalLeadTimeDays Int?           @map("typical_lead_time_days")
  location            String?

  orders                Order[]
  disruptionPredictions DisruptionPrediction[]
  recommendations       Recommendation[]
  autoTriggerRules      AutoTriggerRule[]

  @@map("suppliers")
}

model InventoryItem {
  id                String     @id @default(uuid())
  tenantId          String     @map("tenant_id")
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  sku               String
  name              String
  quantityOnHand    Decimal    @map("quantity_on_hand") @db.Decimal(18, 4)
  reorderThreshold  Decimal?   @map("reorder_threshold") @db.Decimal(18, 4)
  dataSourceId      String?    @map("data_source_id")
  dataSource        DataSource? @relation(fields: [dataSourceId], references: [id])
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at")

  orderLineItems OrderLineItem[]

  @@unique([tenantId, sku])
  @@map("inventory_items")
}

enum OrderStatus {
  open
  in_transit
  delivered
  delayed
}

model Order {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  supplierId   String      @map("supplier_id")
  supplier     Supplier    @relation(fields: [supplierId], references: [id])
  status       OrderStatus @default(open)
  expectedDate DateTime?   @map("expected_date") @db.Date

  lineItems       OrderLineItem[]
  logisticsEvents LogisticsEvent[]

  @@map("orders")
}

model OrderLineItem {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id])
  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal       @db.Decimal(18, 4)

  @@map("order_line_items")
}

model LogisticsEvent {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  status     String
  location   String?
  eta        DateTime?
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@map("logistics_events")
}

// --- User Story 2 (T042-T043) --------------------------------------------

enum DisruptionType {
  supplier_delay
  port_congestion
  demand_spike
}

enum PredictionStatus {
  active
  resolved_true_positive
  resolved_false_positive
  expired
}

model DisruptionPrediction {
  id                        String           @id @default(uuid())
  tenantId                  String           @map("tenant_id")
  tenant                    Tenant           @relation(fields: [tenantId], references: [id])
  type                      DisruptionType
  affectedSupplierId        String?          @map("affected_supplier_id")
  affectedSupplier          Supplier?        @relation(fields: [affectedSupplierId], references: [id])
  affectedInventoryItemIds  String[]         @map("affected_inventory_item_ids")
  confidenceScore           Float            @map("confidence_score")
  predictedImpactAt         DateTime         @map("predicted_impact_at")
  status                    PredictionStatus @default(active)
  createdByAgent            String           @map("created_by_agent")
  /// Plain-language explanation from the Prediction Agent — an
  /// implementation addition beyond data-model.md's original field list,
  /// needed to build Alert.summary (T048) without re-deriving it later.
  rationale                 String
  createdAt                 DateTime         @default(now()) @map("created_at")

  alert Alert?

  @@map("disruption_predictions")
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

enum AlertStatus {
  new
  acknowledged
  acted_on
  dismissed
  escalated
  expired
}

model Alert {
  id                     String       @id @default(uuid())
  tenantId               String       @map("tenant_id")
  tenant                 Tenant       @relation(fields: [tenantId], references: [id])
  disruptionPredictionId String       @unique @map("disruption_prediction_id")
  disruptionPrediction   DisruptionPrediction @relation(fields: [disruptionPredictionId], references: [id])
  severity                AlertSeverity
  status                  AlertStatus  @default(new)
  channelsSent            String[]     @map("channels_sent")
  /// Plain-language content (T048) — extends data-model.md's Alert entity.
  title                   String
  summary                 String
  createdAt               DateTime     @default(now()) @map("created_at")
  escalatedAt              DateTime?    @map("escalated_at")

  recommendation Recommendation?

  @@map("alerts")
}

// --- User Story 3 (T061-T063) --------------------------------------------

enum RecommendationDecision {
  pending
  accepted
  modified
  dismissed
}

model Recommendation {
  id                            String                 @id @default(uuid())
  alertId                       String                 @unique @map("alert_id")
  alert                         Alert                  @relation(fields: [alertId], references: [id])
  /// Ordered plain-language steps (FR-007).
  steps                         Json
  recommendedSupplierId         String?                @map("recommended_supplier_id")
  recommendedSupplier           Supplier?              @relation(fields: [recommendedSupplierId], references: [id])
  recommendedDirectoryEntryId   String?                @map("recommended_directory_entry_id")
  recommendedDirectoryEntry     LocalSupplierDirectoryEntry? @relation(fields: [recommendedDirectoryEntryId], references: [id])
  ownerDecision                 RecommendationDecision @default(pending) @map("owner_decision")
  decidedAt                     DateTime?              @map("decided_at")
  decidedByUserId                String?                @map("decided_by_user_id")
  decidedByUser                  User?                  @relation(fields: [decidedByUserId], references: [id])
  autoTriggered                  Boolean                @default(false) @map("auto_triggered")

  @@map("recommendations")
}

/// Global — platform-curated, NOT tenant-scoped (research.md §7). No RLS:
/// every tenant may read this directory; only the platform team curates it.
model LocalSupplierDirectoryEntry {
  id                     String   @id @default(uuid())
  name                   String
  sector                 String
  location               String?
  capacityLeadTimeDays   Int?     @map("capacity_lead_time_days")
  verified               Boolean  @default(false)

  recommendations Recommendation[]

  @@map("local_supplier_directory_entries")
}

model AutoTriggerRule {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  scopeSupplierId  String?   @map("scope_supplier_id")
  scopeSupplier    Supplier? @relation(fields: [scopeSupplierId], references: [id])
  enabled          Boolean   @default(true)
  /// e.g. { "max_order_value": 5000, "min_confidence": 0.85 }
  conditions       Json
  createdByUserId  String    @map("created_by_user_id")
  createdByUser    User      @relation(fields: [createdByUserId], references: [id])

  @@map("auto_trigger_rules")
}

/// Append-only. Application layer must never expose an update/delete path
/// for this model (Constitution Principle IV + user's explicit audit-log
/// requirement).
model AuditLogEntry {
  id         String   @id @default(uuid())
  /// Nullable for platform_admin actions that span tenants.
  tenantId   String?  @map("tenant_id")
  actor      String
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log_entries")
}
