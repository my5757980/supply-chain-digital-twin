# apps/ai-service environment (see specs/001-supply-chain-digital-twin/quickstart.md)

# LLM provider — any OpenAI-compatible chat-completions endpoint.
# Defaults below target Groq; swap these three values to change provider
# (no code change needed — see research.md §2).
LLM_API_KEY=replace-with-your-provider-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

DATABASE_URL=postgresql://app_runtime:app_runtime_local_dev@localhost:5433/scdt
API_CALLBACK_URL=http://localhost:4000
SERVICE_TOKEN=replace-with-a-shared-service-token
