# Prisma
apps/api/prisma/*.db

# Demo build artefacts — regenerate with demo/record-demo.mjs and
# demo/build-video.ps1. The finished video is committed; the raw capture
# and the intermediate caption files are not.
demo/raw/
demo/frames/
demo/.build/
demo/.probe*

# Playwright MCP scratch
.playwright-mcp/

# Playwright accessibility snapshots land in the repo root when a bare
# filename is passed, and they capture whatever page was open — which has
# included personal data from logged-in sites. Root-level only, so nested
# config and CI YAML is unaffected.
/*.yml
!/docker-compose.yml
